<!--
  Managed configuration schema for EMM/MDM solutions.
  See docs/emm-managed-configurations.md

  - Restrictions are grouped in sections using 'bundle' restrictions.
    Groups are flattened when read (see ManagedConfig), so keys must be unique.
  - Keys of restrictions which override a preference are same as the preference key.
  - Settings which can be left to the user default to "Defined by user" (empty value, or 0).
    So booleans use the 'choice' type.
-->
<restrictions xmlns:android="http://schemas.android.com/apk/res/android">

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Interface ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <restriction
        android:key="interface"
        android:restrictionType="bundle"
        android:title="@string/pref_ui">

        <restriction
            android:defaultValue="false"
            android:description="@string/restriction_lock_settings_desc"
            android:key="lock_settings"
            android:restrictionType="bool"
            android:title="@string/restriction_lock_settings_title" />

        <restriction
            android:defaultValue=""
            android:entries="@array/restriction_theme_entries"
            android:entryValues="@array/restriction_theme_values"
            android:key="theme"
            android:restrictionType="choice"
            android:title="@string/pref_theme" />

        <restriction
            android:defaultValue=""
            android:entries="@array/restriction_bool_entries"
            android:entryValues="@array/restriction_bool_values"
            android:key="bell_enabled"
            android:restrictionType="choice"
            android:title="@string/pref_bell" />

        <restriction
            android:defaultValue=""
            android:entries="@array/restriction_bool_entries"
            android:entryValues="@array/restriction_bool_values"
            android:key="sort_server_list"
            android:restrictionType="choice"
            android:title="@string/pref_sort_server_list" />

        <restriction
            android:defaultValue=""
            android:entries="@array/restriction_bool_entries"
            android:entryValues="@array/restriction_bool_values"
            android:key="prefer_advanced_editor"
            android:restrictionType="choice"
            android:title="@string/pref_prefer_advanced_editor" />
    </restriction>

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Viewer ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <restriction
        android:key="viewer"
        android:restrictionType="bundle"
        android:title="@string/pref_viewer">

        <restriction
            android:defaultValue=""
            android:description="@string/restriction_viewer_orientation_desc"
            android:entries="@array/restriction_orientation_entries"
            android:entryValues="@array/restriction_orientation_values"
            android:key="viewer_orientation"
            android:restrictionType="choice"
            android:title="@string/pref_orientation" />

        <restriction
            android:defaultValue=""
            android:description="@string/restriction_fullscreen_display_desc"
            android:entries="@array/restriction_bool_entries"
            android:entryValues="@array/restriction_bool_values"
            android:key="fullscreen_display"
            android:restrictionType="choice"
            android:title="@string/pref_fullscreen" />

        <restriction
            android:defaultValue=""
            android:description="@string/restriction_keep_screen_on_desc"
            android:entries="@array/restriction_bool_entries"
            android:entryValues="@array/restriction_bool_values"
            android:key="keep_screen_on"
            android:restrictionType="choice"
            android:title="@string/pref_keep_screen_on" />
    </restriction>

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Input ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <restriction
        android:key="input"
        android:restrictionType="bundle"
        android:title="@string/pref_input">

        <restriction
            android:key="input_gestures"
            android:restrictionType="bundle"
            android:title="@string/pref_gesture">

            <restriction
                android:defaultValue=""
                android:description="@string/restriction_gesture_style_desc"
                android:entries="@array/restriction_pref_gesture_style_entries"
                android:entryValues="@array/restriction_pref_gesture_style_values"
                android:key="gesture_style"
                android:restrictionType="choice"
                android:title="@string/pref_gesture_style" />

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_double_tap_action_entries"
                android:entryValues="@array/restriction_double_tap_action_values"
                android:key="gesture_double_tap"
                android:restrictionType="choice"
                android:title="@string/pref_double_tap" />

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_long_press_action_entries"
                android:entryValues="@array/restriction_long_press_action_values"
                android:key="gesture_long_press"
                android:restrictionType="choice"
                android:title="@string/pref_long_press" />

            <restriction
                android:defaultValue=""
                android:description="@string/restriction_gesture_tap2_desc"
                android:entries="@array/restriction_tap2_action_entries"
                android:entryValues="@array/restriction_tap2_action_values"
                android:key="gesture_tap2"
                android:restrictionType="choice"
                android:title="@string/pref_two_finger_tap" />

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_tap3_action_entries"
                android:entryValues="@array/restriction_tap3_action_values"
                android:key="gesture_tap3"
                android:restrictionType="choice"
                android:title="@string/pref_three_finger_tap" />

            <restriction
                android:defaultValue=""
                android:description="@string/restriction_gesture_swipe1_desc"
                android:entries="@array/restriction_swipe1_action_entries"
                android:entryValues="@array/restriction_swipe1_action_values"
                android:key="gesture_swipe1"
                android:restrictionType="choice"
                android:title="@string/pref_swipe1" />

            <restriction
                android:defaultValue=""
                android:description="@string/restriction_gesture_swipe2_desc"
                android:entries="@array/restriction_swipe2_action_entries"
                android:entryValues="@array/restriction_swipe2_action_values"
                android:key="gesture_swipe2"
                android:restrictionType="choice"
                android:title="@string/pref_swipe2" />

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_swipe3_action_entries"
                android:entryValues="@array/restriction_swipe3_action_values"
                android:key="gesture_swipe3"
                android:restrictionType="choice"
                android:title="@string/pref_swipe3" />

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_double_tap_swipe_action_entries"
                android:entryValues="@array/restriction_double_tap_swipe_action_values"
                android:key="gesture_double_tap_swipe"
                android:restrictionType="choice"
                android:title="@string/pref_double_tap_swipe" />

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_long_press_swipe_action_entries"
                android:entryValues="@array/restriction_long_press_swipe_action_values"
                android:key="gesture_long_press_swipe"
                android:restrictionType="choice"
                android:title="@string/pref_long_press_swipe" />

            <restriction
                android:defaultValue="0"
                android:description="@string/restriction_gesture_swipe_sensitivity_desc"
                android:key="gesture_swipe_sensitivity"
                android:restrictionType="integer"
                android:title="@string/pref_swipe_sensitivity" />

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_bool_entries"
                android:entryValues="@array/restriction_bool_values"
                android:key="invert_vertical_scrolling"
                android:restrictionType="choice"
                android:title="@string/pref_invert_vertical_scrolling" />
        </restriction>

        <restriction
            android:key="input_mouse"
            android:restrictionType="bundle"
            android:title="@string/pref_mouse">

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_bool_entries"
                android:entryValues="@array/restriction_bool_values"
                android:key="mouse_passthrough"
                android:restrictionType="choice"
                android:title="@string/pref_mouse_passthrough" />

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_bool_entries"
                android:entryValues="@array/restriction_bool_values"
                android:key="capture_pointer"
                android:restrictionType="choice"
                android:title="@string/pref_capture_pointer" />

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_bool_entries"
                android:entryValues="@array/restriction_bool_values"
                android:key="hide_local_cursor"
                android:restrictionType="choice"
                android:title="@string/pref_hide_local_cursor" />

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_bool_entries"
                android:entryValues="@array/restriction_bool_values"
                android:key="hide_remote_cursor"
                android:restrictionType="choice"
                android:title="@string/title_hide_remote_cursor" />

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_mouse_back_action_entries"
                android:entryValues="@array/restriction_mouse_back_action_values"
                android:key="mouse_back"
                android:restrictionType="choice"
                android:title="@string/pref_mouse_back" />
        </restriction>

        <restriction
            android:key="input_virtual_keys"
            android:restrictionType="bundle"
            android:title="@string/pref_vk">

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_bool_entries"
                android:entryValues="@array/restriction_bool_values"
                android:key="vk_open_with_keyboard"
                android:restrictionType="choice"
                android:title="@string/pref_vk_open_with_keyboard" />

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_bool_entries"
                android:entryValues="@array/restriction_bool_values"
                android:key="vk_use_super_with_single_tap"
                android:restrictionType="choice"
                android:title="@string/pref_vk_use_super_with_single_tap" />

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_vk_row_count_entries"
                android:entryValues="@array/restriction_vk_row_count_values"
                android:key="vk_row_count"
                android:restrictionType="choice"
                android:title="@string/pref_vk_row_count" />
        </restriction>

        <restriction
            android:key="input_key_mapping"
            android:restrictionType="bundle"
            android:title="@string/pref_km">

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_bool_entries"
                android:entryValues="@array/restriction_bool_values"
                android:key="km_right_alt_to_super"
                android:restrictionType="choice"
                android:title="@string/pref_km_right_alt_to_super" />

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_bool_entries"
                android:entryValues="@array/restriction_bool_values"
                android:key="km_language_switch_to_super"
                android:restrictionType="choice"
                android:title="@string/pref_km_language_switch_to_super" />

            <restriction
                android:defaultValue=""
                android:entries="@array/restriction_bool_entries"
                android:entryValues="@array/restriction_bool_values"
                android:key="km_back_to_escape"
                android:restrictionType="choice"
                android:title="@string/pref_km_back_to_escape" />
        </restriction>
    </restriction>

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Servers ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <restriction
        android:key="servers"
        android:restrictionType="bundle"
        android:title="@string/pref_servers">

        <restriction
            android:defaultValue=""
            android:description="@string/restriction_auto_reconnect_desc"
            android:entries="@array/restriction_bool_entries"
            android:entryValues="@array/restriction_bool_values"
            android:key="auto_reconnect"
            android:restrictionType="choice"
            android:title="@string/pref_auto_reconnect" />

        <restriction
            android:defaultValue=""
            android:description="@string/pref_saved_server_lock_summary"
            android:entries="@array/restriction_bool_entries"
            android:entryValues="@array/restriction_bool_values"
            android:key="lock_saved_server"
            android:restrictionType="choice"
            android:title="@string/pref_saved_server_lock" />

        <restriction
            android:defaultValue="false"
            android:description="@string/restriction_lock_servers_desc"
            android:key="lock_servers"
            android:restrictionType="bool"
            android:title="@string/restriction_lock_servers_title" />
    </restriction>

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Tools ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <restriction
        android:key="tools"
        android:restrictionType="bundle"
        android:title="@string/pref_tools">

        <restriction
            android:defaultValue="false"
            android:description="@string/restriction_lock_import_export_desc"
            android:key="lock_import_export"
            android:restrictionType="bool"
            android:title="@string/restriction_lock_import_export_title" />
    </restriction>

    <!--~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Managed servers ~~~~~~~~~~~~~~~~~~~~~~~~~~~~-->
    <restriction
        android:description="@string/restriction_managed_servers_desc"
        android:key="managed_servers"
        android:restrictionType="bundle_array"
        android:title="@string/restriction_managed_servers_title">

        <restriction
            android:key="managed_server"
            android:restrictionType="bundle"
            android:title="@string/restriction_managed_server_title">

            <restriction
                android:defaultValue=""
                android:description="@string/restriction_server_id_desc"
                android:key="id"
                android:restrictionType="string"
                android:title="@string/restriction_server_id_title" />

            <restriction
                android:defaultValue=""
                android:description="@string/restriction_server_name_desc"
                android:key="name"
                android:restrictionType="string"
                android:title="@string/restriction_server_name_title" />

            <restriction
                android:defaultValue=""
                android:description="@string/restriction_server_host_desc"
                android:key="host"
                android:restrictionType="string"
                android:title="@string/hint_host" />

            <restriction
                android:defaultValue="5900"
                android:description="@string/restriction_server_port_desc"
                android:key="port"
                android:restrictionType="integer"
                android:title="@string/hint_port" />

            <restriction
                android:defaultValue=""
                android:description="@string/restriction_server_username_desc"
                android:key="username"
                android:restrictionType="string"
                android:title="@string/hint_username" />

            <restriction
                android:defaultValue="0"
                android:entries="@array/profile_editor_security_labels"
                android:entryValues="@array/profile_editor_security_values"
                android:key="security_type"
                android:restrictionType="choice"
                android:title="@string/title_vnc_security" />

            <restriction
                android:defaultValue="false"
                android:description="@string/restriction_server_view_only_desc"
                android:key="view_only"
                android:restrictionType="bool"
                android:title="@string/restriction_server_view_only_title" />

            <!-- SSH tunnel -->
            <restriction
                android:key="ssh"
                android:restrictionType="bundle"
                android:title="@string/restriction_server_ssh_group_title">

                <restriction
                    android:defaultValue="tcp"
                    android:entries="@array/restriction_channel_type_entries"
                    android:entryValues="@array/restriction_channel_type_values"
                    android:key="channel_type"
                    android:restrictionType="choice"
                    android:title="@string/restriction_server_channel_type_title" />

                <restriction
                    android:defaultValue=""
                    android:description="@string/restriction_server_ssh_host_desc"
                    android:key="ssh_host"
                    android:restrictionType="string"
                    android:title="@string/hint_ssh_host" />

                <restriction
                    android:defaultValue="22"
                    android:description="@string/restriction_server_ssh_port_desc"
                    android:key="ssh_port"
                    android:restrictionType="integer"
                    android:title="@string/hint_ssh_port" />

                <restriction
                    android:defaultValue=""
                    android:description="@string/restriction_server_ssh_username_desc"
                    android:key="ssh_username"
                    android:restrictionType="string"
                    android:title="@string/restriction_server_ssh_username_title" />

                <restriction
                    android:defaultValue="password"
                    android:description="@string/restriction_server_ssh_auth_type_desc"
                    android:entries="@array/restriction_ssh_auth_type_entries"
                    android:entryValues="@array/restriction_ssh_auth_type_values"
                    android:key="ssh_auth_type"
                    android:restrictionType="choice"
                    android:title="@string/restriction_server_ssh_auth_type_title" />
            </restriction>

            <!-- Advanced: optional fields, left to the user unless set (see ManagedField) -->
            <restriction
                android:key="advanced"
                android:restrictionType="bundle"
                android:title="@string/title_advanced">

                <restriction
                    android:defaultValue=""
                    android:description="@string/restriction_server_optional_desc"
                    android:entries="@array/restriction_server_gesture_style_entries"
                    android:entryValues="@array/restriction_server_gesture_style_values"
                    android:key="gesture_style"
                    android:restrictionType="choice"
                    android:title="@string/pref_gesture_style" />

                <restriction
                    android:defaultValue=""
                    android:description="@string/restriction_server_optional_desc"
                    android:entries="@array/restriction_orientation_entries"
                    android:entryValues="@array/restriction_orientation_values"
                    android:key="screen_orientation"
                    android:restrictionType="choice"
                    android:title="@string/title_orientation" />

                <restriction
                    android:defaultValue=""
                    android:description="@string/restriction_server_optional_desc"
                    android:entries="@array/restriction_image_quality_entries"
                    android:entryValues="@array/restriction_image_quality_values"
                    android:key="image_quality"
                    android:restrictionType="choice"
                    android:title="@string/title_image_quality" />

                <restriction
                    android:defaultValue=""
                    android:description="@string/restriction_server_optional_desc"
                    android:entries="@array/restriction_bool_entries"
                    android:entryValues="@array/restriction_bool_values"
                    android:key="use_raw_encoding"
                    android:restrictionType="choice"
                    android:title="@string/title_image_quality_raw" />

                <restriction
                    android:defaultValue=""
                    android:description="@string/restriction_server_optional_desc"
                    android:entries="@array/restriction_bool_entries"
                    android:entryValues="@array/restriction_bool_values"
                    android:key="resize_remote_desktop"
                    android:restrictionType="choice"
                    android:title="@string/title_resize_remote_desktop" />

                <restriction
                    android:defaultValue=""
                    android:description="@string/restriction_server_optional_desc"
                    android:entries="@array/restriction_bool_entries"
                    android:entryValues="@array/restriction_bool_values"
                    android:key="button_up_delay"
                    android:restrictionType="choice"
                    android:title="@string/title_button_up_delay" />

                <restriction
                    android:defaultValue=""
                    android:description="@string/restriction_server_optional_desc"
                    android:entries="@array/restriction_bool_entries"
                    android:entryValues="@array/restriction_bool_values"
                    android:key="connect_on_app_start"
                    android:restrictionType="choice"
                    android:title="@string/title_connect_on_app_start" />

                <restriction
                    android:defaultValue=""
                    android:description="@string/restriction_server_optional_desc"
                    android:entries="@array/restriction_bool_entries"
                    android:entryValues="@array/restriction_bool_values"
                    android:key="enable_wol"
                    android:restrictionType="choice"
                    android:title="@string/title_enable_wol" />

                <restriction
                    android:defaultValue=""
                    android:description="@string/restriction_server_wol_mac_desc"
                    android:key="wol_mac"
                    android:restrictionType="string"
                    android:title="@string/hint_wol_mac" />

                <restriction
                    android:defaultValue=""
                    android:description="@string/restriction_server_wol_broadcast_address_desc"
                    android:key="wol_broadcast_address"
                    android:restrictionType="string"
                    android:title="@string/hint_wol_address" />

                <restriction
                    android:defaultValue="0"
                    android:description="@string/restriction_server_wol_port_desc"
                    android:key="wol_port"
                    android:restrictionType="integer"
                    android:title="@string/restriction_server_wol_port_title" />
            </restriction>
        </restriction>
    </restriction>

</restrictions>
